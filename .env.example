CHAIN_ID="vsc-localnet-0"
GRPC_ENDPOINT="localhost:9090"
WEBSOCKET_ENDPOINT="ws://localhost:26657/websocket"
FEEDER_MNEMONIC="guard cream sadness conduct invite crumble clock pudding hole grit liar hotel maid produce squeeze return argue turtle know drive eight casino maze host"
EXCHANGE_SYMBOLS_MAP='{"coingecko": {"vasg:usdt": "vitalik-smart-gas"}}'
DATASOURCE_CONFIG_MAP='{"coingecko": {"api_key": "0123456789"}}'

# Reading avsg:ausd off the VSCDex USDC/WVSG pool. Both the RPC endpoint and the
# pool address have to be set explicitly, there are no defaults.
# The pool reports token0 = USDC (6 decimals), token1 = WVSG (18 decimals), so
# the quote token is token0 and invert has to be true.
# min_quote_liquidity is the floor in quote tokens (USDC here) below which the
# pool is considered too thin to be a defensible oracle source, and is skipped.
# EXCHANGE_SYMBOLS_MAP='{"vscdex": {"avsg:ausd": "VSGUSD"}}'
# DATASOURCE_CONFIG_MAP='{"vscdex": {"rpc_url": "https://rpc.vscblockchain.org", "pools": {"VSGUSD": {"address": "0xdbd23389df918176abf0e6f73cadefbbbac93d87", "token0_decimals": 6, "token1_decimals": 18, "invert": true, "min_quote_liquidity": 25000}}}}'
VALIDATOR_ADDRESS="nibi1zaavvzxez0elundtn32qnk9lkm8kmcsz44g7xl"